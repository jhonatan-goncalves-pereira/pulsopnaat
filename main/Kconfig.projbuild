menu "PulsoPNAAT"

    menu "I2C & GPIO (BNO085)"
        config APP_BNO085_I2C_SDA_GPIO
            int "I2C SDA GPIO"
            default 6
            help
                GPIO pin for I2C SDA (data line).

        config APP_BNO085_I2C_SCL_GPIO
            int "I2C SCL GPIO"
            default 7
            help
                GPIO pin for I2C SCL (clock line).

        config APP_BNO085_I2C_ADDR
            hex "BNO085 I2C Address"
            default 0x28
            range 0x00 0x7F
            help
                Endereço I2C de 7 bits do BNO085 no barramento:
                0x28 quando AD0=GND, 0x29 quando AD0=VCC
                (wiring do Heltec LoRa V3 no README do driver: AD0→GND → 0x28).

        config APP_BNO085_I2C_FREQ_HZ
            int "I2C Clock Frequency (Hz)"
            default 400000
            range 100000 1000000
            help
                Frequência do barramento I2C. Padrão: 400 kHz.

        config APP_BNO085_INT_GPIO
            int "BNO085 INT (data-ready) GPIO"
            default 5
            help
                GPIO pin for BNO085 H_INTN interrupt (active-low).

        config APP_BNO085_RST_GPIO
            int "BNO085 RST (reset) GPIO"
            default 4
            help
                GPIO pin for BNO085 NRST reset (active-low).
    endmenu

    menu "Aquisição de vibração"
        config PULSOPNAAT_SENSOR_REPORT_INTERVAL_US
            int "Intervalo de reporte do RAW_ACCELEROMETER (µs)"
            default 2500
            range 1000 1000000
            help
                Período de reporte do SH2 RAW_ACCELEROMETER (0x14), sem fusão
                sensorial. 2500 µs ≈ 400 Hz nominais; a taxa efetiva é medida
                por timestamps SH-2 e registrada no log a cada janela
                (Δ esperado entre amostras ≈ 2,5 ms).

        config PULSOPNAAT_RAW_ACCEL_UG_PER_LSB
            int "Escala do RAW_ACCELEROMETER (µg por LSB)"
            default 1000
            range 1 1000000
            help
                Conversão contagens de ADC → m/s²: valor nominal 1000 µg/LSB
                (1 LSB ≈ 1 mg). O reporte 0x14 entrega contagens sem escala
                fixa documentada (o fator nominal fica no FRS 0xE301 do
                sensor). CONFIRMAR empiricamente na bancada: em repouso, o eixo
                alinhado à gravidade deve indicar ≈ 9,81 m/s² de RMS, ou
                compare com o reporte calibrado 0x01. O pipeline de detecção é
                relativo ao baseline, portanto erro de escala não afeta a
                classificação — apenas os valores absolutos impressos.

        config PULSOPNAAT_FILA_JANELAS
            int "Profundidade da fila de janelas (amostragem → processamento)"
            default 2
            range 1 8
            help
                Cada item é uma janela triaxial de 400×3 amostras float
                (~4,8 KB). Fila cheia → a janela mais antiga é descartada
                (overwrite-oldest), para que a amostragem nunca seja bloqueada
                nem atrasada pelo consumo; o descarte é contado e registrado
                no log.
    endmenu

endmenu
