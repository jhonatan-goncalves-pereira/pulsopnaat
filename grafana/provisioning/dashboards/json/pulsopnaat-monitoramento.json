{
  "uid": "pulsopnaat-monitor",
  "title": "PulsoPNAAT — Monitoramento em tempo real",
  "tags": [
    "pulsopnaat"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 11,
      "type": "stat",
      "title": "Velocidade atual (reconhecida pelo modelo)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 7,
        "h": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "pulsopnaat-influxdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "pulsopnaat-influxdb"
          },
          "query": "from(bucket: \"mqtt_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"pulsopnaat_telemetria\" and r._field == \"regime\")\n  |> last()\n  |> keep(columns: [\"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#6e6e6e"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "SEM MODELO",
                  "color": "#6e6e6e",
                  "index": 0
                },
                "0": {
                  "text": "PARADO",
                  "color": "#8f8f8f",
                  "index": 1
                },
                "1": {
                  "text": "VELOCIDADE 1",
                  "color": "#8ab8ff",
                  "index": 2
                },
                "2": {
                  "text": "VELOCIDADE 2",
                  "color": "#3274d9",
                  "index": 3
                },
                "3": {
                  "text": "VELOCIDADE 3",
                  "color": "#1f3fa8",
                  "index": 4
                },
                "4": {
                  "text": "FALHA DE ALIMENTAÇÃO",
                  "color": "red",
                  "index": 5
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
