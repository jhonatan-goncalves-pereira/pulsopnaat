# Cópia local: cp .env.example .env
# O arquivo .env NUNCA vai para o Git (ver .gitignore).
# Valores abaixo são só para bancada local — troque antes de expor.
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=adminpassword
INFLUXDB_ORG=myorg
INFLUXDB_BUCKET=mqtt_data
INFLUXDB_TOKEN=my-super-secret-admin-token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# true = quem abre o link vê o dashboard sem login (só leitura). Ao ativar, troque a senha acima.
GRAFANA_ANONYMOUS_ENABLED=false
# Porta do Grafana no host; troque se a 3000 já estiver em uso (ex.: outro projeto web).
GRAFANA_PORT=3000
# Broker de onde o Telegraf lê: o mesmo configurado no firmware (menuconfig → MQTT Broker URI).
# Local: tcp://mosquitto:1883
MQTT_BROKER=tcp://broker.mqttdashboard.com:1883
