# Cópia local: cp .env.example .env
# O arquivo .env NUNCA vai para o Git (ver .gitignore).
# Valores abaixo são só para bancada local — troque antes de expor.
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=adminpassword
INFLUXDB_ORG=myorg
INFLUXDB_BUCKET=mqtt_data
INFLUXDB_TOKEN=my-super-secret-admin-token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
